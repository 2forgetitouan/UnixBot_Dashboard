<%# Features page - uses layouts/public.ejs %>

<!-- Hero -->
<section class="page-hero">
  <div class="container">
    <span class="section-tag" data-animate="fadeInUp">Fonctionnalités</span>
    <h1 class="page-hero__title" data-animate="fadeInUp">Tout pour gérer votre serveur</h1>
    <p class="page-hero__desc" data-animate="fadeInUp">
      UnixBot centralise les outils essentiels dans un seul bot - gratuit, open-source
      et accessible depuis un dashboard web moderne.
    </p>
  </div>
</section>

<!-- Main features -->
<section class="features-detailed">
  <div class="container">

    <!-- Feature block 1 -->
    <div class="feat-block" data-animate="fadeInUp">
      <div class="feat-block__icon feat-block__icon--purple">
        <i data-lucide="gift"></i>
      </div>
      <div class="feat-block__content">
        <h2 class="feat-block__title">Giveaways</h2>
        <p class="feat-block__desc">
          Organisez des concours directement depuis Discord ou le dashboard web.
          Définissez une durée, un nombre de gagnants et un prix - le bot s'occupe
          du reste : embed riche, réactions, tirage au sort et annonce des résultats.
        </p>
        <ul class="feat-block__list">
          <li><i data-lucide="check"></i> Création par commande slash ou dashboard</li>
          <li><i data-lucide="check"></i> Tirage au sort automatique à la fin du timer</li>
          <li><i data-lucide="check"></i> Reroll des gagnants en un clic</li>
          <li><i data-lucide="check"></i> Historique complet & statistiques</li>
          <li><i data-lucide="check"></i> Multi-giveaways simultanés par serveur</li>
        </ul>
      </div>
    </div>

    <!-- Feature block 2 -->
    <div class="feat-block feat-block--reverse" data-animate="fadeInUp">
      <div class="feat-block__icon feat-block__icon--blue">
        <i data-lucide="shield"></i>
      </div>
      <div class="feat-block__content">
        <h2 class="feat-block__title">Modération</h2>
        <p class="feat-block__desc">
          Gardez votre serveur propre grâce aux outils de modération intégrés.
          Purge de messages en masse, gestion des permissions et journalisation
          des actions pour une traçabilité complète.
        </p>
        <ul class="feat-block__list">
          <li><i data-lucide="check"></i> Purge intelligente (par utilisateur, nombre, ancienneté)</li>
          <li><i data-lucide="check"></i> Permissions granulaires (admins, owners, superusers)</li>
          <li><i data-lucide="check"></i> Logs détaillés de toutes les actions</li>
          <li><i data-lucide="check"></i> Commandes réservées aux rôles autorisés</li>
        </ul>
      </div>
    </div>

    <!-- Feature block 3 -->
    <div class="feat-block" data-animate="fadeInUp">
      <div class="feat-block__icon feat-block__icon--green">
        <i data-lucide="arrow-up-circle"></i>
      </div>
      <div class="feat-block__content">
        <h2 class="feat-block__title">Auto-Bump</h2>
        <p class="feat-block__desc">
          Automatisez le bump de votre serveur sur les plateformes de listing.
          Le moteur d'auto-bump planifie les rappels et peut exécuter les bumps
          de manière autonome selon vos préférences.
        </p>
        <ul class="feat-block__list">
          <li><i data-lucide="check"></i> Rappels automatiques dans le salon de votre choix</li>
          <li><i data-lucide="check"></i> Self-bump autonome (sans intervention)</li>
          <li><i data-lucide="check"></i> Statistiques de bumps (quotidien, hebdomadaire)</li>
          <li><i data-lucide="check"></i> Configuration complète depuis le dashboard</li>
        </ul>
      </div>
    </div>

    <!-- Feature block 4 -->
    <div class="feat-block feat-block--reverse" data-animate="fadeInUp">
      <div class="feat-block__icon feat-block__icon--amber">
        <i data-lucide="message-square"></i>
      </div>
      <div class="feat-block__content">
        <h2 class="feat-block__title">Messages &amp; Embeds</h2>
        <p class="feat-block__desc">
          Envoyez des messages texte ou des embeds riches dans n'importe quel salon
          de votre serveur, directement depuis le dashboard. Idéal pour les annonces,
          règlements et messages d'information.
        </p>
        <ul class="feat-block__list">
          <li><i data-lucide="check"></i> Éditeur visuel d'embeds (titre, description, couleur, champs)</li>
          <li><i data-lucide="check"></i> Envoi dans n'importe quel salon texte</li>
          <li><i data-lucide="check"></i> Prévisualisation en temps réel</li>
          <li><i data-lucide="check"></i> Historique des messages envoyés</li>
        </ul>
      </div>
    </div>

    <!-- Feature block 5 -->
    <div class="feat-block" data-animate="fadeInUp">
      <div class="feat-block__icon feat-block__icon--red">
        <i data-lucide="archive"></i>
      </div>
      <div class="feat-block__content">
        <h2 class="feat-block__title">Anti-Archive</h2>
        <p class="feat-block__desc">
          Empêchez les forums et threads de votre serveur de s'archiver automatiquement.
          Configurez la protection par salon et laissez le bot gérer la ré-ouverture
          silencieuse des threads.
        </p>
        <ul class="feat-block__list">
          <li><i data-lucide="check"></i> Protection automatique contre l'archivage</li>
          <li><i data-lucide="check"></i> Configuration par salon (allowarchive / noarchive)</li>
          <li><i data-lucide="check"></i> Auto-unarchive transparent</li>
          <li><i data-lucide="check"></i> Aucune perturbation pour les utilisateurs</li>
        </ul>
      </div>
    </div>

    <!-- Feature block 6 -->
    <div class="feat-block feat-block--reverse" data-animate="fadeInUp">
      <div class="feat-block__icon feat-block__icon--teal">
        <i data-lucide="layout-dashboard"></i>
      </div>
      <div class="feat-block__content">
        <h2 class="feat-block__title">Dashboard Web</h2>
        <p class="feat-block__desc">
          Gérez l'intégralité du bot depuis une interface web moderne. Connexion
          sécurisée via Discord OAuth2, vue multi-serveurs, et toutes les fonctionnalités
          accessibles sans taper une seule commande.
        </p>
        <ul class="feat-block__list">
          <li><i data-lucide="check"></i> Authentification OAuth2 Discord</li>
          <li><i data-lucide="check"></i> Gestion multi-serveurs centralisée</li>
          <li><i data-lucide="check"></i> Interface responsive (mobile, tablette, desktop)</li>
          <li><i data-lucide="check"></i> Statistiques et graphiques en temps réel</li>
        </ul>
      </div>
    </div>

  </div>
</section>

<!-- CTA -->
<section class="page-cta">
  <div class="container page-cta__inner">
    <h2 data-animate="fadeInUp">Convaincu ?</h2>
    <p data-animate="fadeInUp">Ajoutez UnixBot à votre serveur et profitez de toutes ces fonctionnalités gratuitement.</p>
    <div class="page-cta__actions" data-animate="fadeInUp">
      <a href="/api/v1/auth/bot-invite" class="btn btn-primary btn-xl" onclick="window.openOAuthPopup(this.href); return false;">
        <i data-lucide="plus-circle"></i>
        <span>Ajouter à Discord</span>
      </a>
      <a href="/commands" class="btn btn-outline btn-xl">
        <i data-lucide="book-open"></i>
        <span>Voir les commandes</span>
      </a>
    </div>
  </div>
</section>
