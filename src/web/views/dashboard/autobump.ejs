<!-- Alert pour les tokens de bot -->
<div class="alert alert-danger hidden" id="botTokenAlert">
  <i data-lucide="alert-triangle"></i>
  <div>
    <strong>Token de bot détecté !</strong>
    <p>
      L'auto-bump nécessite un token de <strong>compte utilisateur</strong>,
      pas un token de bot. L'utilisation d'un token de bot ne fonctionnera pas.
    </p>
  </div>
</div>

<!-- Skeleton Loading State -->
<div id="autobumpSkeleton">
  <div class="status-card">
    <div class="master-switch-header">
      <div class="master-switch-info">
        <div class="skeleton-badge" style="width: 100px"></div>
        <div class="skeleton-text w-lg skeleton-mt-2"></div>
      </div>
      <div class="skeleton-toggle"></div>
    </div>
    <div class="bump-stats skeleton-mt-4">
      <div class="stat-item"><div class="skeleton-text w-sm"></div><div class="skeleton-text w-md"></div></div>
      <div class="stat-item"><div class="skeleton-text w-sm"></div><div class="skeleton-text w-md"></div></div>
      <div class="stat-item"><div class="skeleton-text w-sm"></div><div class="skeleton-text w-md"></div></div>
    </div>
  </div>
  <div class="form-card skeleton-mt-6">
    <div class="skeleton-heading" style="width: 180px"></div>
    <div class="skeleton-input skeleton-mt-4"></div>
    <div class="skeleton-input skeleton-mt-3"></div>
  </div>
  <div class="form-card skeleton-mt-6">
    <div class="skeleton-heading" style="width: 220px"></div>
    <div class="autobump-skeleton-services">
      <div class="skeleton-service-item"><div class="skeleton-text w-md"></div><div class="skeleton-toggle"></div></div>
      <div class="skeleton-service-item"><div class="skeleton-text w-md"></div><div class="skeleton-toggle"></div></div>
      <div class="skeleton-service-item"><div class="skeleton-text w-md"></div><div class="skeleton-toggle"></div></div>
    </div>
  </div>
</div>

<!-- Main Content (hidden until loaded) -->
<div id="autobumpContent" class="hidden">

  <!-- Master Switch Card -->
  <div class="status-card" id="statusCard">
    <div class="master-switch-header">
      <div class="master-switch-info">
        <div class="status-indicator" id="statusIndicator">
          <span class="status-dot"></span>
          <span class="status-text">Chargement...</span>
        </div>
        <p class="status-description" id="statusDescription">
          Automatisez les bumps de votre serveur sur les différentes plateformes.
        </p>
      </div>
      <div class="master-switch-control">
        <label class="switch-large hidden" id="masterSwitchContainer">
          <input type="checkbox" id="masterSwitch">
          <span class="switch-slider-large"></span>
        </label>
      </div>
    </div>

    <!-- Token User Info -->
    <div class="token-user-info hidden" id="tokenUserInfo">
      <img src="" alt="Avatar" class="token-user-avatar" id="tokenUserAvatar">
      <div class="token-user-details">
        <span class="token-user-name" id="tokenUserName"></span>
        <span class="token-user-id" id="tokenUserId"></span>
      </div>
      <span class="token-verified-badge">
        <i data-lucide="check-circle"></i>
        Vérifié
      </span>
    </div>

    <!-- Stats -->
    <div class="bump-stats hidden" id="bumpStats">
      <div class="stat-item">
        <span class="stat-value" id="totalBumps">0</span>
        <span class="stat-label">Bumps totaux</span>
      </div>
      <div class="stat-item">
        <span class="stat-value" id="lastBump">-</span>
        <span class="stat-label">Dernier bump</span>
      </div>
      <div class="stat-item hidden" id="nextBumpContainer">
        <span class="stat-value" id="nextBump">-</span>
        <span class="stat-label">Prochain bump</span>
      </div>
    </div>
  </div>

  <!-- Configuration Form -->
  <form id="autobumpForm" data-guild-id="<%= guild.id %>">
    <!-- Token Section -->
    <div class="form-card" id="authCard">
      <h3>
        <i data-lucide="key"></i>
        <span>Authentification</span>
      </h3>

      <div class="form-group">
        <label for="userToken">
          Token utilisateur Discord
          <span class="required" id="tokenRequired">*</span>
        </label>
        <div class="token-input-wrapper">
          <input
            type="password"
            id="userToken"
            name="token"
            class="form-input"
            placeholder="Collez votre token Discord ici"
            autocomplete="off"
          >
          <button type="button" class="btn-icon" id="toggleTokenVisibility" title="Afficher/Masquer">
            <i data-lucide="eye"></i>
          </button>
          <button type="button" class="btn btn-secondary" id="btnVerifyToken">
            <i data-lucide="check"></i>
            Vérifier
          </button>
        </div>
        <small class="form-help">
          <i data-lucide="info"></i>
          Le token est chiffré et stocké de manière sécurisée. Une fois configuré, vous n'avez pas besoin de le saisir à nouveau sauf pour le modifier.
          <a href="#" id="tokenHelpLink">Comment obtenir mon token ?</a>
        </small>

        <!-- Token verification result -->
        <div class="token-verification hidden" id="tokenVerification">
          <div class="verification-loading hidden" id="verificationLoading">
            <div class="spinner"></div>
            <span>Vérification en cours...</span>
          </div>
          <div class="verification-success hidden" id="verificationSuccess">
            <i data-lucide="check-circle"></i>
            <img src="" alt="Avatar" class="verified-avatar" id="verifiedAvatar">
            <div class="verified-info">
              <span class="verified-name" id="verifiedName"></span>
              <span class="verified-id" id="verifiedId"></span>
            </div>
          </div>
          <div class="verification-error hidden" id="verificationError">
            <i data-lucide="x-circle"></i>
            <span id="verificationErrorText"></span>
          </div>
        </div>
      </div>

      <!-- Channel -->
      <div class="form-group">
        <label for="bumpChannel">
          Salon de bump
          <span class="required">*</span>
        </label>
        <select id="bumpChannel" name="channelId" class="form-select">
          <option value="">Sélectionner un salon</option>
          <% channels.forEach(channel => { %>
          <option value="<%= channel.id %>">#<%= channel.name %></option>
          <% }) %>
        </select>
        <small class="form-help">
          <i data-lucide="info"></i>
          Le salon où les commandes de bump seront envoyées.
        </small>
      </div>
    </div>

    <!-- Services Section -->
    <div class="form-card">
      <div class="form-card-header">
        <h3>
          <i data-lucide="zap"></i>
          <span>Services de bump activés</span>
        </h3>
        <span class="badge badge-secondary badge-sm hidden" id="servicesCount"></span>
      </div>

      <div class="services-list" id="servicesList">
        <!-- Filled by JS -->
      </div>

      <div class="empty-state hidden" id="servicesEmpty">
        <div class="empty-state-illustration">
          <svg width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="50" cy="50" r="38" fill="var(--bg-tertiary)" stroke="var(--border-color)" stroke-width="2"/>
            <path d="M55 25 L45 55 H58 L48 80" stroke="var(--text-muted)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.4"/>
            <line x1="35" y1="35" x2="65" y2="65" stroke="var(--danger)" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
          </svg>
        </div>
        <h3>Aucun service disponible</h3>
        <p>Ajoutez un service personnalisé pour commencer.</p>
      </div>

      <button type="button" class="btn btn-secondary btn-add-service" id="btnAddCustomService">
        <i data-lucide="plus"></i>
        Ajouter un service personnalisé
      </button>
    </div>
  </form>

  <!-- History -->
  <div class="form-card">
    <div class="form-card-header">
      <h3>
        <i data-lucide="history"></i>
        <span>Historique des bumps</span>
      </h3>
      <span class="badge badge-secondary badge-sm hidden" id="historyCount"></span>
    </div>

    <div class="data-table-wrapper">
      <table class="data-table" id="historyTable">
        <thead>
          <tr>
            <th>Date</th>
            <th>Service</th>
            <th>Statut</th>
            <th>Message</th>
          </tr>
        </thead>
        <tbody id="historyTableBody">
          <tr>
            <td colspan="4" class="text-center text-muted">Aucun historique disponible</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Delete Config Section -->
  <div class="form-card danger-zone-card hidden" id="dangerZone">
    <h3 class="danger-zone-title">
      <i data-lucide="alert-triangle"></i>
      <span>Zone de danger</span>
    </h3>
    <p class="danger-zone-description">
      Supprimer la configuration de l'auto-bump supprimera tous les paramètres et l'historique.
    </p>
    <button type="button" class="btn btn-danger" id="btnDelete">
      <i data-lucide="trash-2"></i>
      Supprimer la configuration
    </button>
  </div>

</div>

<!-- Confirm Delete Modal -->
<div class="modal" id="confirmDeleteModal" role="dialog" aria-modal="true" aria-labelledby="confirmDeleteTitle">
  <div class="modal-backdrop" data-modal-close></div>
  <div class="modal-content modal-sm">
    <div class="modal-header">
      <h2 id="confirmDeleteTitle">Confirmer la suppression</h2>
      <button class="modal-close" data-modal-close>
        <i data-lucide="x"></i>
      </button>
    </div>
    <div class="modal-body">
      <p id="confirmDeleteText">Êtes-vous sûr de vouloir supprimer cette configuration ? Cette action est irréversible.</p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-modal-close>Annuler</button>
      <button type="button" class="btn btn-danger" id="btnConfirmDelete">
        <i data-lucide="trash-2"></i>
        Supprimer
      </button>
    </div>
  </div>
</div>

<!-- Confirm Delete Service Modal -->
<div class="modal" id="confirmDeleteServiceModal" role="dialog" aria-modal="true" aria-labelledby="confirmDeleteServiceTitle">
  <div class="modal-backdrop" data-modal-close></div>
  <div class="modal-content modal-sm">
    <div class="modal-header">
      <h2 id="confirmDeleteServiceTitle">Supprimer le service</h2>
      <button class="modal-close" data-modal-close>
        <i data-lucide="x"></i>
      </button>
    </div>
    <div class="modal-body">
      <p>Êtes-vous sûr de vouloir supprimer le service <strong id="deleteServiceName"></strong> ?</p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-modal-close>Annuler</button>
      <button type="button" class="btn btn-danger" id="btnConfirmDeleteService">
        <i data-lucide="trash-2"></i>
        Supprimer
      </button>
    </div>
  </div>
</div>

<!-- Token Help Modal -->
<div class="modal" id="tokenHelpModal" role="dialog" aria-modal="true" aria-labelledby="tokenHelpTitle">
  <div class="modal-backdrop" data-modal-close></div>
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="tokenHelpTitle">Comment obtenir votre token Discord ?</h2>
      <button class="modal-close" data-modal-close>
        <i data-lucide="x"></i>
      </button>
    </div>
    <div class="modal-body">
      <div class="alert alert-warning">
        <i data-lucide="alert-triangle"></i>
        <div>
          <strong>Important</strong>
          <p>Ne partagez <strong>jamais</strong> votre token avec quiconque.</p>
        </div>
      </div>

      <h4>Étapes :</h4>
      <ol class="token-steps">
        <li>Ouvrez Discord dans votre navigateur (<a href="https://discord.com/app" target="_blank" rel="noopener noreferrer">discord.com/app</a>)</li>
        <li>Appuyez sur <kbd>F12</kbd> ou <kbd>Ctrl+Shift+I</kbd> pour ouvrir les outils de développement</li>
        <li>Allez dans l'onglet <strong>Console</strong></li>
        <li>
          Collez ce code et appuyez sur Entrée :
          <pre><code>(webpackChunkdiscord_app.push([[''],{},e=>{m=[];for(let c in e.c)m.push(e.c[c])}]),m).find(m=>m?.exports?.default?.getToken!==void 0).exports.default.getToken()</code></pre>
        </li>
        <li>Copiez le token affiché (sans les guillemets)</li>
      </ol>

      <div class="alert alert-info">
        <i data-lucide="shield"></i>
        <div>
          <strong>Sécurité</strong>
          <p>Votre token est chiffré avec AES-256-GCM avant d'être stocké.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Custom Service Modal -->
<div class="modal" id="customServiceModal" role="dialog" aria-modal="true" aria-labelledby="customServiceModalTitle">
  <div class="modal-backdrop" data-modal-close></div>
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="customServiceModalTitle">Ajouter un service personnalisé</h2>
      <button class="modal-close" data-modal-close>
        <i data-lucide="x"></i>
      </button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="customServiceEditIndex" value="-1">
      <div class="form-group">
        <label for="customServiceName">
          <i data-lucide="tag" class="form-label-icon"></i>
          Nom du service
        </label>
        <input type="text" id="customServiceName" class="form-input" placeholder="Ex: Discordlist" maxlength="50">
      </div>
      <div class="form-group">
        <label for="customServiceBotId">
          <i data-lucide="bot" class="form-label-icon"></i>
          ID du bot
        </label>
        <div class="bot-id-input-wrapper">
          <input type="text" id="customServiceBotId" class="form-input" placeholder="Ex: 123456789012345678" maxlength="20">
          <div class="bot-avatar-preview hidden" id="botAvatarPreview">
            <img src="" alt="Bot avatar" id="botAvatarImg">
            <span id="botAvatarName"></span>
          </div>
          <div class="bot-avatar-error hidden" id="botAvatarError">
            <i data-lucide="alert-circle"></i>
            <span id="botAvatarErrorText"></span>
          </div>
        </div>
        <small class="form-help">
          <i data-lucide="info"></i>
          L'ID du bot qui gère les bumps pour ce service.
        </small>
      </div>
      <div class="form-divider"></div>
      <div class="form-group">
        <label for="customServiceCommand">
          <i data-lucide="terminal" class="form-label-icon"></i>
          Commande
        </label>
        <input type="text" id="customServiceCommand" class="form-input" placeholder="Ex: bump" maxlength="50">
        <small class="form-help">
          <i data-lucide="info"></i>
          Le nom de la commande slash à exécuter (sans le /).
        </small>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="customServiceMinDelay">
            <i data-lucide="clock" class="form-label-icon"></i>
            Délai minimum (heures)
          </label>
          <input type="number" id="customServiceMinDelay" class="form-input" min="0.5" max="24" step="0.5" value="2">
        </div>
        <div class="form-group">
          <label for="customServiceMaxDelay">
            <i data-lucide="clock" class="form-label-icon"></i>
            Délai maximum (heures)
          </label>
          <input type="number" id="customServiceMaxDelay" class="form-input" min="1" max="24" step="0.5" value="3">
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-modal-close>Annuler</button>
      <button type="button" class="btn btn-primary" id="btnConfirmAddService">
        <i data-lucide="plus"></i>
        <span id="btnConfirmAddServiceText">Ajouter</span>
      </button>
    </div>
  </div>
</div>
