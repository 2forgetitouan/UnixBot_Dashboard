<!-- Stats Bar -->
<div class="commands-stats" id="commandsStats">
  <div class="stat-pill">
    <i data-lucide="terminal"></i>
    <span id="totalCount">0</span> commandes
  </div>
  <div class="stat-pill stat-success">
    <i data-lucide="check-circle"></i>
    <span id="enabledCount">0</span> activées
  </div>
  <div class="stat-pill stat-danger">
    <i data-lucide="x-circle"></i>
    <span id="disabledCount">0</span> désactivées
  </div>
</div>

<!-- Category Filter -->
<div class="category-filter" id="categoryFilter">
  <button class="category-btn active" data-category="all">
    Toutes
  </button>
</div>

<!-- Bulk Actions -->
<div class="bulk-actions hidden" id="bulkActions">
  <span class="bulk-label">
    <i data-lucide="layers"></i>
    Actions groupées :
  </span>
  <button class="btn btn-sm btn-success" id="bulkEnableBtn">
    <i data-lucide="toggle-right"></i>
    <span>Tout activer</span>
  </button>
  <button class="btn btn-sm btn-danger" id="bulkDisableBtn">
    <i data-lucide="toggle-left"></i>
    <span>Tout désactiver</span>
  </button>
</div>

<!-- Commands Container -->
<div class="commands-container">
  <!-- Skeleton loading state -->
  <div id="loadingState">
    <div class="skeleton-commands-grid">
      <% for (let i = 0; i < 6; i++) { %>
      <div class="skeleton-command-card skeleton">
        <div class="skeleton-cmd-header">
          <div class="skeleton-row">
            <div class="skeleton-badge skeleton"></div>
            <div class="skeleton-text w-xs skeleton"></div>
          </div>
          <div class="skeleton-toggle skeleton"></div>
        </div>
        <div class="skeleton-text w-lg skeleton"></div>
        <div class="skeleton-text w-sm skeleton"></div>
        <div class="skeleton-row-between">
          <div class="skeleton-text w-sm h-xs skeleton"></div>
          <div class="skeleton-btn sm skeleton"></div>
        </div>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Empty state -->
  <div class="empty-state hidden" id="emptyState">
    <div class="empty-state-illustration">
      <svg width="120" height="100" viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="10" y="15" width="100" height="70" rx="8" fill="var(--bg-tertiary)" stroke="var(--border-color)" stroke-width="2"/>
        <rect x="10" y="15" width="100" height="18" rx="8" fill="var(--bg-secondary)"/>
        <rect x="10" y="25" width="100" height="8" fill="var(--bg-secondary)"/>
        <circle cx="24" cy="24" r="3" fill="var(--danger)" opacity="0.6"/>
        <circle cx="34" cy="24" r="3" fill="var(--warning)" opacity="0.6"/>
        <circle cx="44" cy="24" r="3" fill="var(--success)" opacity="0.6"/>
        <text x="20" y="52" font-family="monospace" font-size="11" fill="var(--text-muted)">$ _</text>
        <rect x="20" y="60" width="50" height="6" rx="3" fill="var(--border-color)" opacity="0.4"/>
        <rect x="20" y="70" width="35" height="6" rx="3" fill="var(--border-color)" opacity="0.3"/>
      </svg>
    </div>
    <h3>Aucune commande trouvée</h3>
    <p>Essayez avec d'autres critères de recherche ou une autre catégorie</p>
  </div>

  <!-- Error state -->
  <div class="empty-state hidden" id="errorState">
    <div class="empty-state-illustration">
      <svg width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="50" cy="50" r="40" fill="var(--bg-tertiary)" stroke="var(--danger)" stroke-width="2" opacity="0.3"/>
        <circle cx="50" cy="50" r="28" fill="var(--bg-secondary)" stroke="var(--danger)" stroke-width="2" opacity="0.5"/>
        <text x="50" y="55" text-anchor="middle" font-size="28" fill="var(--danger)" font-weight="bold">!</text>
      </svg>
    </div>
    <h3>Erreur de chargement</h3>
    <p id="errorMessage">Impossible de charger les commandes</p>
    <button class="btn btn-primary" id="retryBtn">
      <i data-lucide="refresh-cw"></i>
      <span>Réessayer</span>
    </button>
  </div>

  <!-- Search results count -->
  <div class="search-results-info hidden" id="searchResultsInfo">
    <span id="searchResultsCount">0</span> résultat(s) trouvé(s)
  </div>

  <!-- Commands List (populated by JS) -->
  <div class="commands-list hidden" id="commandsList"></div>
</div>

<!-- Command Edit Modal -->
<div class="modal" id="editModal" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
  <div class="modal-backdrop" data-modal-close></div>
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="editModalTitle">Configurer la commande</h2>
      <button class="modal-close" data-modal-close>
        <i data-lucide="x"></i>
      </button>
    </div>

    <form id="editCommandForm">
      <div class="modal-body">
        <div class="command-info-header">
          <span class="command-name" id="modalCommandName">/command</span>
          <span class="command-category-badge" id="modalCommandCategory">Catégorie</span>
        </div>
        <p class="command-description" id="modalCommandDesc">
          Description de la commande
        </p>

        <div class="form-divider"></div>

        <div class="form-group">
          <label class="toggle-label">
            <input type="checkbox" id="commandEnabled" checked>
            <span class="toggle-slider"></span>
            <span>Commande activée</span>
          </label>
        </div>

        <div class="form-group">
          <label for="cooldownSeconds">
            <i data-lucide="clock" class="form-label-icon"></i>
            Cooldown (secondes)
          </label>
          <input
            type="number"
            id="cooldownSeconds"
            class="form-input"
            value="0"
            min="0"
            max="3600"
          >
          <small>0 = pas de cooldown personnalisé</small>
        </div>

        <div class="form-group">
          <label>
            <i data-lucide="shield-check" class="form-label-icon"></i>
            Rôles autorisés
          </label>
          <div class="role-selector" id="allowedRoles">
            <% roles.forEach(role => { %>
            <label class="role-chip" style="--role-color: <%= role.color %>">
              <input type="checkbox" name="allowed_roles" value="<%= role.id %>">
              <span><%= role.name %></span>
            </label>
            <% }) %>
          </div>
          <small>Laissez vide pour autoriser tout le monde</small>
        </div>

        <div class="form-group">
          <label>
            <i data-lucide="shield-x" class="form-label-icon"></i>
            Rôles bloqués
          </label>
          <div class="role-selector" id="deniedRoles">
            <% roles.forEach(role => { %>
            <label class="role-chip" style="--role-color: <%= role.color %>">
              <input type="checkbox" name="denied_roles" value="<%= role.id %>">
              <span><%= role.name %></span>
            </label>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" id="resetCommandBtn" title="Réinitialiser les paramètres par défaut">
          <i data-lucide="rotate-ccw"></i>
          <span>Réinitialiser</span>
        </button>
        <div class="modal-footer-right">
          <button type="button" class="btn btn-secondary" data-modal-close>
            Annuler
          </button>
          <button type="submit" class="btn btn-primary">
            <i data-lucide="save"></i>
            <span>Sauvegarder</span>
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Confirm Reset Modal -->
<div class="modal" id="confirmResetModal" role="dialog" aria-modal="true" aria-labelledby="confirmResetTitle">
  <div class="modal-backdrop" data-modal-close></div>
  <div class="modal-content modal-sm">
    <div class="modal-header">
      <h2 id="confirmResetTitle">Réinitialiser la commande</h2>
      <button class="modal-close" data-modal-close>
        <i data-lucide="x"></i>
      </button>
    </div>
    <div class="modal-body">
      <p class="confirm-message">
        Êtes-vous sûr de vouloir réinitialiser <strong id="resetCommandName">/command</strong> à ses paramètres par défaut ?
        Les rôles autorisés, bloqués et le cooldown seront supprimés.
      </p>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" data-modal-close>Annuler</button>
      <button class="btn btn-danger" id="confirmResetBtn">
        <i data-lucide="rotate-ccw"></i>
        <span>Réinitialiser</span>
      </button>
    </div>
  </div>
</div>
