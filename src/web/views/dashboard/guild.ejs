<!-- Stats Cards -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-card-icon">
      <i data-lucide="gift"></i>
    </div>
    <div class="stat-card-content">
      <span class="stat-card-value"><%= stats.giveaways.active || 0 %></span>
      <span class="stat-card-label">Giveaways actifs</span>
    </div>
    <a href="/dashboard/guild/<%= guild.id %>/giveaways" class="stat-card-link" title="Voir les giveaways">
      <i data-lucide="arrow-right"></i>
    </a>
  </div>

  <div class="stat-card stat-card-autobump <%= stats.autobump?.isActive ? 'active' : '' %>">
    <div class="stat-card-icon">
      <i data-lucide="refresh-cw"></i>
    </div>
    <div class="stat-card-content">
      <% if (stats.autobump?.configured) { %>
        <span class="stat-card-value stat-value-status">
          <span class="status-dot-small <%= stats.autobump.isActive ? 'active' : 'inactive' %>"></span>
          <%= stats.autobump.isActive ? 'Actif' : 'Inactif' %>
        </span>
        <span class="stat-card-label">
          Auto-Bump (<%= stats.autobump.totalBumps || 0 %> bumps)
        </span>
      <% } else { %>
        <span class="stat-card-value stat-value-muted">Non configuré</span>
        <span class="stat-card-label">Auto-Bump</span>
      <% } %>
    </div>
    <a href="/dashboard/guild/<%= guild.id %>/autobump" class="stat-card-link" title="Configurer l'auto-bump">
      <i data-lucide="arrow-right"></i>
    </a>
  </div>

  <div class="stat-card">
    <div class="stat-card-icon">
      <i data-lucide="message-square"></i>
    </div>
    <div class="stat-card-content">
      <span class="stat-card-value"><%= stats.messages || 0 %></span>
      <span class="stat-card-label">Messages envoyés</span>
    </div>
    <a href="/dashboard/guild/<%= guild.id %>/messages" class="stat-card-link" title="Voir les messages">
      <i data-lucide="arrow-right"></i>
    </a>
  </div>

  <div class="stat-card">
    <div class="stat-card-icon">
      <i data-lucide="users"></i>
    </div>
    <div class="stat-card-content">
      <span class="stat-card-value"><%= stats.owners || 0 %></span>
      <span class="stat-card-label">Administrateurs</span>
    </div>
  </div>
</div>

<!-- Quick Actions -->
<div class="section-header">
  <h2>
    <i data-lucide="zap" class="section-icon"></i>
    Actions rapides
  </h2>
</div>

<div class="quick-actions">
  <a href="/dashboard/guild/<%= guild.id %>/giveaways" class="action-card">
    <div class="action-card-icon">
      <i data-lucide="gift"></i>
    </div>
    <div class="action-card-content">
      <span class="action-card-title">Giveaways</span>
      <span class="action-card-desc">Créer et gérer les giveaways</span>
    </div>
    <i data-lucide="chevron-right" class="action-card-arrow"></i>
  </a>
  <a href="/dashboard/guild/<%= guild.id %>/messages" class="action-card">
    <div class="action-card-icon">
      <i data-lucide="send"></i>
    </div>
    <div class="action-card-content">
      <span class="action-card-title">Messages</span>
      <span class="action-card-desc">Envoyer des messages et embeds</span>
    </div>
    <i data-lucide="chevron-right" class="action-card-arrow"></i>
  </a>
  <a href="/dashboard/guild/<%= guild.id %>/autobump" class="action-card">
    <div class="action-card-icon">
      <i data-lucide="refresh-cw"></i>
    </div>
    <div class="action-card-content">
      <span class="action-card-title">Auto-Bump</span>
      <span class="action-card-desc">Configurer le bump automatique</span>
    </div>
    <i data-lucide="chevron-right" class="action-card-arrow"></i>
  </a>
  <a href="/dashboard/guild/<%= guild.id %>/commands" class="action-card">
    <div class="action-card-icon">
      <i data-lucide="terminal"></i>
    </div>
    <div class="action-card-content">
      <span class="action-card-title">Commandes</span>
      <span class="action-card-desc">Activer ou désactiver les commandes</span>
    </div>
    <i data-lucide="chevron-right" class="action-card-arrow"></i>
  </a>
</div>

<!-- Quick Settings Overview -->
<div class="section-header">
  <h2>
    <i data-lucide="settings" class="section-icon"></i>
    Configuration rapide
  </h2>
  <a href="/dashboard/guild/<%= guild.id %>/settings" class="btn btn-ghost btn-sm">
    <span>Tous les paramètres</span>
    <i data-lucide="arrow-right"></i>
  </a>
</div>

<div class="overview-settings-grid">
  <div class="overview-setting-card">
    <div class="overview-setting-header">
      <div class="overview-setting-icon">
        <i data-lucide="hand"></i>
      </div>
      <div class="overview-setting-info">
        <span class="overview-setting-title">Message de bienvenue</span>
        <span class="overview-setting-status">
          <% if (guild.settings.welcome_enabled) { %>
            <span class="status-dot-small active"></span> Activé
          <% } else { %>
            <span class="status-dot-small inactive"></span> Désactivé
          <% } %>
        </span>
      </div>
    </div>
    <% if (guild.settings.welcome_enabled && guild.settings.welcome_channel_id) { %>
    <div class="overview-setting-detail">
      <i data-lucide="hash"></i>
      <span><%= channels.find(c => c.id === guild.settings.welcome_channel_id)?.name || 'Salon inconnu' %></span>
    </div>
    <% } %>
  </div>

  <div class="overview-setting-card">
    <div class="overview-setting-header">
      <div class="overview-setting-icon">
        <i data-lucide="file-text"></i>
      </div>
      <div class="overview-setting-info">
        <span class="overview-setting-title">Salon de logs</span>
        <span class="overview-setting-status">
          <% if (guild.settings.log_channel_id) { %>
            <span class="status-dot-small active"></span> Configuré
          <% } else { %>
            <span class="status-dot-small inactive"></span> Non configuré
          <% } %>
        </span>
      </div>
    </div>
    <% if (guild.settings.log_channel_id) { %>
    <div class="overview-setting-detail">
      <i data-lucide="hash"></i>
      <span><%= channels.find(c => c.id === guild.settings.log_channel_id)?.name || 'Salon inconnu' %></span>
    </div>
    <% } %>
  </div>

  <div class="overview-setting-card">
    <div class="overview-setting-header">
      <div class="overview-setting-icon">
        <i data-lucide="gift"></i>
      </div>
      <div class="overview-setting-info">
        <span class="overview-setting-title">Salon giveaways</span>
        <span class="overview-setting-status">
          <% if (guild.settings.giveaway_channel_id) { %>
            <span class="status-dot-small active"></span> Configuré
          <% } else { %>
            <span class="status-dot-small inactive"></span> Tous les salons
          <% } %>
        </span>
      </div>
    </div>
    <% if (guild.settings.giveaway_channel_id) { %>
    <div class="overview-setting-detail">
      <i data-lucide="hash"></i>
      <span><%= channels.find(c => c.id === guild.settings.giveaway_channel_id)?.name || 'Salon inconnu' %></span>
    </div>
    <% } %>
  </div>

  <div class="overview-setting-card">
    <div class="overview-setting-header">
      <div class="overview-setting-icon">
        <i data-lucide="archive-restore"></i>
      </div>
      <div class="overview-setting-info">
        <span class="overview-setting-title">Auto-désarchivage</span>
        <span class="overview-setting-status">
          <% if (guild.settings.auto_unarchive_enabled) { %>
            <span class="status-dot-small active"></span> Activé
          <% } else { %>
            <span class="status-dot-small inactive"></span> Désactivé
          <% } %>
        </span>
      </div>
    </div>
  </div>
</div>
