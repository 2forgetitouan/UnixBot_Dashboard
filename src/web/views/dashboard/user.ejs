<%
  const guildsWithBot = guilds.filter(g => g.botPresent);
  const guildsWithoutBot = guilds.filter(g => !g.botPresent);
  const botRatio = stats.totalGuilds > 0
    ? Math.round((stats.guildsWithBot / stats.totalGuilds) * 100)
    : 0;
%>

<!-- User Profile Card -->
<div class="user-profile-card">
  <div class="profile-avatar-wrapper">
    <img src="<%= user.avatarUrl %>" alt="<%= user.username %>" class="profile-avatar" width="96" height="96">
    <% if (user.avatarDecoration) { %>
    <img
      src="https://cdn.discordapp.com/avatar-decoration-presets/<%= user.avatarDecoration %>.png?passthrough=true"
      alt=""
      class="profile-avatar-decoration<%= user.avatarDecoration.startsWith('a_') ? ' animated' : '' %>"
    >
    <% } %>
  </div>
  <div class="profile-info">
    <h2><%= user.username %></h2>
    <% if (user.isSuperuser) { %>
    <span class="badge badge-primary"><i data-lucide="shield-check"></i> Superuser</span>
    <% } %>
  </div>
</div>

<!-- Stats Cards -->
<div class="user-stats-grid">
  <div class="user-stat-card">
    <div class="user-stat-icon">
      <i data-lucide="server"></i>
    </div>
    <div class="user-stat-content">
      <span class="user-stat-value"><%= stats.totalGuilds %></span>
      <span class="user-stat-label">Serveurs</span>
    </div>
  </div>
  <div class="user-stat-card accent">
    <div class="user-stat-icon">
      <i data-lucide="bot"></i>
    </div>
    <div class="user-stat-content">
      <span class="user-stat-value"><%= stats.guildsWithBot %></span>
      <span class="user-stat-label">Avec le bot</span>
    </div>
  </div>
  <div class="user-stat-card">
    <div class="user-stat-icon">
      <i data-lucide="percent"></i>
    </div>
    <div class="user-stat-content">
      <span class="user-stat-value"><%= botRatio %>%</span>
      <span class="user-stat-label">Couverture</span>
    </div>
  </div>
</div>

<!-- Search / Filter -->
<% if (guilds.length > 3) { %>
<div class="guilds-toolbar">
  <div class="guilds-search-wrapper">
    <i data-lucide="search" class="guilds-search-icon"></i>
    <input
      type="text"
      id="guildSearch"
      class="guilds-search-input"
      placeholder="Rechercher un serveur..."
      autocomplete="off"
    />
  </div>
  <div class="guilds-filter-group">
    <button class="guilds-filter-btn active" data-filter="all">Tous (<%= guilds.length %>)</button>
    <button class="guilds-filter-btn" data-filter="with">Avec bot (<%= guildsWithBot.length %>)</button>
    <button class="guilds-filter-btn" data-filter="without">Sans bot (<%= guildsWithoutBot.length %>)</button>
  </div>
</div>
<% } %>

<!-- Guild cards -->
<div class="guilds-grid" id="guildsGrid">
  <% if (guilds.length === 0) { %>
  <div class="empty-state-card full-width">
    <div class="empty-state-illustration">
      <svg width="120" height="100" viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="20" y="20" width="80" height="60" rx="8" fill="var(--bg-tertiary)" stroke="var(--border-color)" stroke-width="2"/>
        <rect x="35" y="35" width="22" height="22" rx="4" fill="var(--bg-secondary)" stroke="var(--border-color)" stroke-width="1.5"/>
        <rect x="63" y="35" width="22" height="22" rx="4" fill="var(--bg-secondary)" stroke="var(--border-color)" stroke-width="1.5" opacity="0.5"/>
        <rect x="35" y="62" width="50" height="5" rx="2.5" fill="var(--border-color)" opacity="0.3"/>
        <circle cx="46" cy="46" r="6" fill="var(--text-muted)" opacity="0.2"/>
        <text x="46" y="49" text-anchor="middle" font-size="8" fill="var(--text-muted)" opacity="0.4">#</text>
      </svg>
    </div>
    <h3>Aucun serveur trouvé</h3>
    <p>Vous n'administrez aucun serveur Discord pour le moment.</p>
  </div>
  <% } else { %>
    <% guildsWithBot.forEach(guild => { %>
  <div class="guild-card" data-guild-name="<%= guild.name.toLowerCase() %>" data-bot="with">
    <div class="guild-card-header">
      <% if (guild.iconUrl) { %>
      <img src="<%= guild.iconUrl %>" alt="<%= guild.name %>" class="guild-icon" width="48" height="48" loading="lazy" decoding="async">
      <% } else { %>
      <div class="guild-icon-placeholder"><%= guild.name.charAt(0).toUpperCase() %></div>
      <% } %>
      <div class="guild-card-info">
        <h3><%= guild.name %></h3>
        <div class="guild-card-meta">
          <% if (guild.owner) { %>
          <span class="badge badge-secondary"><i data-lucide="crown"></i> Propriétaire</span>
          <% } %>
          <% if (guild.memberCount) { %>
          <span class="guild-stat"><i data-lucide="users"></i> <%= guild.memberCount.toLocaleString('fr-FR') %></span>
          <% } %>
          <span class="status-badge status-online">
            <span class="status-dot"></span>
            <span>Bot actif</span>
          </span>
        </div>
      </div>
    </div>
    <div class="guild-card-actions">
      <a href="/dashboard/guild/<%= guild.id %>" class="btn btn-primary btn-sm">
        <i data-lucide="settings"></i>
        <span>Gérer</span>
      </a>
    </div>
  </div>
    <% }) %>

    <% guildsWithoutBot.forEach(guild => { %>
  <div class="guild-card guild-card-inactive" data-guild-name="<%= guild.name.toLowerCase() %>" data-bot="without">
    <div class="guild-card-header">
      <% if (guild.iconUrl) { %>
      <img src="<%= guild.iconUrl %>" alt="<%= guild.name %>" class="guild-icon" width="48" height="48" loading="lazy" decoding="async">
      <% } else { %>
      <div class="guild-icon-placeholder"><%= guild.name.charAt(0).toUpperCase() %></div>
      <% } %>
      <div class="guild-card-info">
        <h3><%= guild.name %></h3>
        <div class="guild-card-meta">
          <% if (guild.owner) { %>
          <span class="badge badge-secondary"><i data-lucide="crown"></i> Propriétaire</span>
          <% } %>
          <span class="guild-stat guild-stat-muted"><i data-lucide="users"></i> ???</span>
          <span class="status-badge status-offline">
            <span class="status-dot"></span>
            <span>Bot absent</span>
          </span>
        </div>
      </div>
    </div>
    <div class="guild-card-actions">
      <button
        class="btn btn-secondary btn-sm btn-invite"
        data-invite-url="/api/v1/auth/bot-invite?guildId=<%= guild.id %>"
      >
        <i data-lucide="plus"></i>
        <span>Ajouter le bot</span>
      </button>
    </div>
  </div>
    <% }) %>
  <% } %>
</div>

<!-- Empty search state (hidden by default) -->
<div class="empty-state-card hidden" id="emptySearch">
  <i data-lucide="search-x"></i>
  <h3>Aucun résultat</h3>
  <p>Aucun serveur ne correspond à votre recherche.</p>
</div>

<!-- Page-specific script -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // ── Bot invite popup ──
  document.querySelectorAll('.btn-invite').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var url = this.dataset.inviteUrl;
      var w = 500, h = 800;
      var left = (window.innerWidth - w) / 2 + window.screenX;
      var top = (window.innerHeight - h) / 2 + window.screenY;
      var popup = window.open(url, 'discord-bot-invite',
        'width=' + w + ',height=' + h + ',left=' + left + ',top=' + top + ',resizable=yes,scrollbars=yes');
      if (!popup) {
        window.Toast && Toast.error('Le popup a été bloqué. Autorisez les popups pour ce site.');
        return;
      }
      var check = setInterval(function() {
        if (popup.closed) {
          clearInterval(check);
          setTimeout(function() { window.location.reload(); }, 800);
        }
      }, 400);
    });
  });

  // ── Search + Filter ──
  var searchInput = document.getElementById('guildSearch');
  var grid = document.getElementById('guildsGrid');
  var emptySearch = document.getElementById('emptySearch');
  var filterBtns = document.querySelectorAll('.guilds-filter-btn');
  var activeFilter = 'all';

  function applyFilters() {
    if (!grid) return;
    var query = (searchInput ? searchInput.value.toLowerCase().trim() : '');
    var cards = grid.querySelectorAll('.guild-card');
    var visible = 0;

    cards.forEach(function(card) {
      var name = card.dataset.guildName || '';
      var bot = card.dataset.bot || '';
      var matchSearch = !query || name.indexOf(query) !== -1;
      var matchFilter = activeFilter === 'all' || bot === activeFilter;
      var show = matchSearch && matchFilter;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (emptySearch) {
      emptySearch.style.display = (visible === 0 && cards.length > 0) ? '' : 'none';
    }
    if (grid) {
      grid.style.display = (visible === 0 && cards.length > 0) ? 'none' : '';
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', DashboardUtils.debounce(applyFilters, 150));
  }

  filterBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      filterBtns.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      activeFilter = btn.dataset.filter;
      applyFilters();
    });
  });
});
</script>
