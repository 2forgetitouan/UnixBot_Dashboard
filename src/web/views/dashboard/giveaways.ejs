<!-- Tabs -->
<div class="tabs" role="tablist" aria-label="Filtrer les giveaways">
  <button class="tab active" data-tab="active" role="tab" aria-selected="true" aria-controls="tab-active">
    <i data-lucide="clock"></i>
    <span>Actifs</span>
    <span class="tab-count" id="activeCount">0</span>
  </button>
  <button class="tab" data-tab="ended" role="tab" aria-selected="false" aria-controls="tab-ended">
    <i data-lucide="check-circle"></i>
    <span>Terminés</span>
  </button>
  <button class="tab" data-tab="all" role="tab" aria-selected="false" aria-controls="tab-all">
    <i data-lucide="list"></i>
    <span>Tous</span>
  </button>
</div>

<!-- Giveaways Content -->
<div class="giveaways-container">
  <!-- Skeleton loading state -->
  <div class="giveaways-grid" id="loadingState">
    <% for (let i = 0; i < 3; i++) { %>
    <div class="skeleton-giveaway-card skeleton">
      <div class="skeleton-gw-header">
        <div class="skeleton-badge skeleton"></div>
        <div class="skeleton-btn xs skeleton"></div>
      </div>
      <div class="skeleton-gw-body">
        <div class="skeleton-heading skeleton"></div>
        <div class="skeleton-text w-lg skeleton"></div>
      </div>
      <div class="skeleton-gw-footer">
        <div class="skeleton-text w-sm skeleton"></div>
        <div class="skeleton-text w-xs skeleton"></div>
      </div>
    </div>
    <% } %>
  </div>

  <!-- Empty state -->
  <div class="empty-state hidden" id="emptyState">
    <div class="empty-state-illustration">
      <svg width="120" height="100" viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="30" y="40" width="60" height="50" rx="6" fill="var(--bg-tertiary)" stroke="var(--border-color)" stroke-width="2"/>
        <rect x="25" y="30" width="70" height="16" rx="4" fill="var(--primary)" opacity="0.2" stroke="var(--primary)" stroke-width="1.5" stroke-opacity="0.4"/>
        <line x1="60" y1="30" x2="60" y2="90" stroke="var(--border-color)" stroke-width="1.5"/>
        <path d="M60 30 C55 20, 42 18, 40 25 C38 32, 50 30, 60 30" fill="var(--primary)" opacity="0.3"/>
        <path d="M60 30 C65 20, 78 18, 80 25 C82 32, 70 30, 60 30" fill="var(--primary)" opacity="0.3"/>
        <circle cx="90" cy="22" r="8" fill="var(--warning)" opacity="0.15" stroke="var(--warning)" stroke-width="1" stroke-opacity="0.4"/>
        <text x="90" y="26" text-anchor="middle" font-size="10" fill="var(--warning)" opacity="0.7">★</text>
      </svg>
    </div>
    <h3>Aucun giveaway</h3>
    <p>Créez votre premier giveaway pour engager votre communauté</p>
    <button class="btn btn-primary" id="createFirstBtn">
      <i data-lucide="plus"></i>
      <span>Créer un giveaway</span>
    </button>
  </div>

  <!-- Giveaways grid (populated by JS) -->
  <div class="giveaways-grid hidden" id="giveawaysGrid"></div>
</div>

<!-- Create Giveaway Modal -->
<div class="modal" id="createModal" role="dialog" aria-modal="true" aria-labelledby="createModalTitle">
  <div class="modal-backdrop" data-modal-close></div>
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="createModalTitle">Créer un giveaway</h2>
      <button class="modal-close" data-modal-close>
        <i data-lucide="x"></i>
      </button>
    </div>

    <form id="createGiveawayForm">
      <div class="modal-body">
        <div class="form-group">
          <label for="prize">Prix / Récompense *</label>
          <input type="text" id="prize" name="prize" class="form-input"
            placeholder="Ex: Nitro 1 mois" required maxlength="256">
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" class="form-textarea"
            placeholder="Description optionnelle du giveaway" maxlength="2048"></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="channelId">Salon *</label>
            <select id="channelId" name="channelId" class="form-select" required>
              <option value="">Sélectionner un salon</option>
              <% channels.forEach(channel => { %>
              <option value="<%= channel.id %>">#<%= channel.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="winnersCount">Nombre de gagnants *</label>
            <input type="number" id="winnersCount" name="winnersCount" class="form-input"
              value="1" min="1" max="20" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="durationValue">Durée *</label>
            <input type="number" id="durationValue" name="durationValue" class="form-input"
              value="1" min="1" required>
          </div>
          <div class="form-group">
            <label for="durationUnit">Unité</label>
            <select id="durationUnit" name="durationUnit" class="form-select">
              <option value="minutes">Minutes</option>
              <option value="hours" selected>Heures</option>
              <option value="days">Jours</option>
            </select>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-modal-close>Annuler</button>
        <button type="submit" class="btn btn-primary">
          <i data-lucide="gift"></i>
          <span>Créer le giveaway</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Confirm Action Modal -->
<div class="modal" id="confirmModal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
  <div class="modal-backdrop" data-modal-close></div>
  <div class="modal-content modal-sm">
    <div class="modal-header">
      <h2 id="confirmTitle">Confirmer</h2>
      <button class="modal-close" data-modal-close>
        <i data-lucide="x"></i>
      </button>
    </div>
    <div class="modal-body">
      <p id="confirmMessage" class="confirm-message"></p>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-modal-close>Annuler</button>
      <button type="button" class="btn btn-danger" id="confirmActionBtn">
        <span id="confirmActionText">Confirmer</span>
      </button>
    </div>
  </div>
</div>
