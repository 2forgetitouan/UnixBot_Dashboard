          </svg>
        </div>
        <h2 class="contact-card__title">Serveur Discord</h2>
        <p class="contact-card__desc">
          Rejoignez notre serveur de support pour obtenir de l'aide en temps réel,
          signaler des bugs ou simplement discuter avec la communauté.
        </p>
        <span class="contact-card__link">
          Rejoindre le serveur
          <i data-lucide="arrow-right"></i>
        </span>
      </a>

      <!-- GitHub -->
      <a href="https://github.com/" class="contact-card" target="_blank" rel="noopener">
        <div class="contact-card__icon contact-card__icon--github">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
        </div>
        <h2 class="contact-card__title">GitHub</h2>
        <p class="contact-card__desc">
          Ouvrez une issue pour signaler un bug ou proposer une fonctionnalité.
          Les pull requests sont les bienvenues.
        </p>
        <span class="contact-card__link">
          Ouvrir une issue
          <i data-lucide="arrow-right"></i>
        </span>
      </a>

      <!-- Email -->
      <a href="mailto:contact@unixbot.live" class="contact-card">
        <div class="contact-card__icon contact-card__icon--email">
          <i data-lucide="mail"></i>
        </div>
        <h2 class="contact-card__title">Email</h2>
        <p class="contact-card__desc">
          Pour les demandes formelles, partenariats ou questions relatives au RGPD
          et à la protection des données.
        </p>
        <span class="contact-card__link">
          contact@unixbot.live
          <i data-lucide="arrow-right"></i>
        </span>
      </a>

    </div>
  </div>
</section>

<!-- Contact form -->
<section class="contact-form-section">
  <div class="container">
    <div class="section-header" data-animate="fadeInUp">
      <span class="section-tag">Message</span>
      <h2 class="section-title">Envoyez-nous un message</h2>
      <p class="section-desc">
        Remplissez le formulaire ci-dessous et nous vous répondrons dans les
        meilleurs délais.
      </p>
    </div>

    <form class="contact-form" data-animate="fadeInUp" id="contactForm" novalidate>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="contactName">Nom / Pseudo</label>
          <input
            type="text"
            class="form-input"
            id="contactName"
            name="name"
            placeholder="Votre nom ou pseudo Discord"
            required
          />
        </div>
        <div class="form-group">
          <label class="form-label" for="contactEmail">Email</label>
          <input
            type="email"
            class="form-input"
            id="contactEmail"
            name="email"
            placeholder="votre@email.com"
            required
          />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="contactSubject">Sujet</label>
        <select class="form-select" id="contactSubject" name="subject" required>
          <option value="" disabled selected>Choisissez un sujet</option>
          <option value="bug">Signaler un bug</option>
          <option value="feature">Proposer une fonctionnalité</option>
          <option value="support">Demande de support</option>
          <option value="data">Demande RGPD / données personnelles</option>
          <option value="partnership">Partenariat</option>
          <option value="other">Autre</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="contactMessage">Message</label>
        <textarea
          class="form-textarea"
          id="contactMessage"
          name="message"
          rows="6"
          placeholder="Décrivez votre demande en détail…"
          required
        ></textarea>
      </div>

      <div class="contact-form__footer">
        <p class="contact-form__notice">
          <i data-lucide="info"></i>
          En envoyant ce formulaire, vous acceptez que nous utilisions votre email
          uniquement pour vous répondre. Voir notre
          <a href="/legal/privacy">politique de confidentialité</a>.
        </p>
        <button type="submit" class="btn btn-primary btn-lg">
          <i data-lucide="send"></i>
          <span>Envoyer</span>
        </button>
      </div>

      <div class="contact-form__status" id="contactStatus" hidden></div>
    </form>
  </div>
</section>
