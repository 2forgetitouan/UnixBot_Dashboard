<%# Contact page - uses layouts/public.ejs %>

<!-- Hero -->
<section class="page-hero">
  <div class="container">
    <span class="section-tag" data-animate="fadeInUp">Contact</span>
    <h1 class="page-hero__title" data-animate="fadeInUp">Parlons-en</h1>
    <p class="page-hero__desc" data-animate="fadeInUp">
      Une question, un bug, une suggestion ? Plusieurs moyens de nous joindre.
    </p>
  </div>
</section>

<!-- Contact options -->
<section class="contact-section">
  <div class="container">
    <div class="contact-grid" data-animate="fadeInUp">

      <!-- Discord -->
      <a href="https://discord.gg/" class="contact-card" target="_blank" rel="noopener">
