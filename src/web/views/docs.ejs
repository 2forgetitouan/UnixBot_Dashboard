<%# Documentation / FAQ page - uses layouts/public.ejs %>

<!-- Hero -->
<section class="page-hero">
  <div class="container">
    <span class="section-tag" data-animate="fadeInUp">Documentation</span>
    <h1 class="page-hero__title" data-animate="fadeInUp">Guides &amp; FAQ</h1>
    <p class="page-hero__desc" data-animate="fadeInUp">
      Retrouvez ici les réponses aux questions les plus fréquentes et les guides
      pour bien démarrer avec UnixBot.
    </p>
  </div>
</section>

<!-- Quick start -->
<section class="docs-section">
  <div class="container">
    <div class="section-header" data-animate="fadeInUp">
      <span class="section-tag">Démarrage rapide</span>
      <h2 class="section-title">Premiers pas avec UnixBot</h2>
    </div>

    <div class="steps-grid" data-animate="fadeInUp">
      <div class="step-card">
        <div class="step-card__number">1</div>
        <h3 class="step-card__title">Ajoutez le bot</h3>
        <p class="step-card__desc">
          Cliquez sur <a href="/api/v1/auth/bot-invite">Ajouter à Discord</a>,
          sélectionnez votre serveur et acceptez les permissions requises.
        </p>
      </div>

      <div class="step-card">
        <div class="step-card__number">2</div>
        <h3 class="step-card__title">Connectez-vous au dashboard</h3>
        <p class="step-card__desc">
          Rendez-vous sur <a href="/login">la page de connexion</a> et
          authentifiez-vous avec votre compte Discord pour accéder au dashboard.
        </p>
      </div>

      <div class="step-card">
        <div class="step-card__number">3</div>
        <h3 class="step-card__title">Configurez votre serveur</h3>
        <p class="step-card__desc">
          Depuis le dashboard, sélectionnez votre serveur et configurez les
          fonctionnalités : giveaways, auto-bump, messages, anti-archive, etc.
        </p>
      </div>

      <div class="step-card">
        <div class="step-card__number">4</div>
        <h3 class="step-card__title">Utilisez les commandes</h3>
        <p class="step-card__desc">
          Tapez <code>/</code> dans Discord pour voir les commandes slash
          disponibles. Consultez la <a href="/commands">liste des commandes</a>
          pour plus de détails.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="docs-section docs-section--alt">
  <div class="container">
    <div class="section-header" data-animate="fadeInUp">
      <span class="section-tag">FAQ</span>
      <h2 class="section-title">Questions fréquentes</h2>
    </div>

    <div class="faq-grid" data-animate="fadeInUp">

      <!-- General -->
      <h3 class="faq-category">Général</h3>

      <details class="faq-item">
        <summary class="faq-item__q">
          <span>Qu'est-ce qu'UnixBot ?</span>
          <i data-lucide="chevron-down" class="faq-item__chevron"></i>
        </summary>
        <div class="faq-item__a">
          <p>
            UnixBot est un bot Discord multifonction, gratuit et open-source. Il offre
            des fonctionnalités de giveaways, modération, auto-bump, messagerie avancée
            et un dashboard web complet pour gérer votre serveur.
          </p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-item__q">
          <span>UnixBot est-il gratuit ?</span>
          <i data-lucide="chevron-down" class="faq-item__chevron"></i>
        </summary>
        <div class="faq-item__a">
          <p>
            Oui, toutes les fonctionnalités sont entièrement gratuites. Il n'existe
            aucune version premium ou fonctionnalité payante. Le code source est
            disponible publiquement.
          </p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-item__q">
          <span>Comment ajouter UnixBot à mon serveur ?</span>
          <i data-lucide="chevron-down" class="faq-item__chevron"></i>
        </summary>
        <div class="faq-item__a">
          <p>
            Cliquez sur le bouton « Ajouter à Discord » disponible sur la page
            d'accueil ou en haut du site. Sélectionnez votre serveur, acceptez
            les permissions et le bot sera opérationnel immédiatement.
          </p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-item__q">
          <span>Quelles permissions le bot nécessite-t-il ?</span>
          <i data-lucide="chevron-down" class="faq-item__chevron"></i>
        </summary>
        <div class="faq-item__a">
          <p>
            Le bot demande les permissions nécessaires à ses fonctionnalités :
            envoyer des messages, gérer les messages (purge), gérer les threads
            (anti-archive), lire l'historique des messages et ajouter des réactions
            (giveaways). Vous pouvez personnaliser les permissions lors de l'ajout.
          </p>
        </div>
      </details>

      <!-- Dashboard -->
      <h3 class="faq-category">Dashboard</h3>

      <details class="faq-item">
        <summary class="faq-item__q">
          <span>Comment accéder au dashboard ?</span>
          <i data-lucide="chevron-down" class="faq-item__chevron"></i>
        </summary>
        <div class="faq-item__a">
          <p>
            Rendez-vous sur la <a href="/login">page de connexion</a> et
            authentifiez-vous via Discord. Vous serez redirigé vers votre dashboard
            personnel où vous pourrez voir et gérer vos serveurs.
          </p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-item__q">
          <span>Qui peut accéder au dashboard d'un serveur ?</span>
          <i data-lucide="chevron-down" class="faq-item__chevron"></i>
        </summary>
        <div class="faq-item__a">
          <p>
            Seuls les membres ayant la permission <strong>Administrateur</strong>
            sur le serveur, le propriétaire du serveur ou les superusers du bot
            peuvent accéder au dashboard d'un serveur donné.
          </p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-item__q">
          <span>Le dashboard est-il accessible sur mobile ?</span>
          <i data-lucide="chevron-down" class="faq-item__chevron"></i>
        </summary>
        <div class="faq-item__a">
          <p>
            Oui, le dashboard est entièrement responsive et fonctionne sur mobile,
            tablette et ordinateur de bureau. Toutes les fonctionnalités sont
            accessibles depuis n'importe quel appareil.
          </p>
        </div>
      </details>

      <!-- Features -->
      <h3 class="faq-category">Fonctionnalités</h3>

      <details class="faq-item">
        <summary class="faq-item__q">
          <span>Comment lancer un giveaway ?</span>
          <i data-lucide="chevron-down" class="faq-item__chevron"></i>
        </summary>
        <div class="faq-item__a">
          <p>
            Vous pouvez lancer un giveaway de deux façons :
          </p>
          <ul>
            <li>Via la commande slash <code>/giveaway</code> directement dans Discord</li>
            <li>Via le dashboard web, dans la section « Giveaways » de votre serveur</li>
          </ul>
          <p>
            Dans les deux cas, définissez la durée, le prix et le nombre de gagnants,
            puis validez. Le bot créera automatiquement un embed avec un compteur à
            rebours.
          </p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-item__q">
          <span>Comment fonctionne l'auto-bump ?</span>
          <i data-lucide="chevron-down" class="faq-item__chevron"></i>
        </summary>
        <div class="faq-item__a">
          <p>
            L'auto-bump envoie des rappels périodiques dans un salon que vous
            définissez, pour inciter les membres à bumper le serveur. En mode
            « self-bump », le bot peut effectuer les bumps de manière autonome
            sans intervention humaine.
          </p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-item__q">
          <span>Qu'est-ce que l'anti-archive ?</span>
          <i data-lucide="chevron-down" class="faq-item__chevron"></i>
        </summary>
        <div class="faq-item__a">
          <p>
            Discord archive automatiquement les threads inactifs. La fonctionnalité
            anti-archive d'UnixBot détecte ces archivages et ré-ouvre les threads
            de manière transparente, pour que vos discussions restent toujours
            accessibles.
          </p>
        </div>
      </details>

      <!-- Data & Security -->
      <h3 class="faq-category">Données &amp; Sécurité</h3>

      <details class="faq-item">
        <summary class="faq-item__q">
          <span>Quelles données sont collectées ?</span>
          <i data-lucide="chevron-down" class="faq-item__chevron"></i>
        </summary>
        <div class="faq-item__a">
          <p>
            UnixBot ne collecte que les données strictement nécessaires : identifiant
            Discord et nom d'utilisateur (pour l'authentification), identifiants des
            serveurs gérés et données de configuration. Aucun contenu de message
            n'est stocké. Consultez notre
            <a href="/legal/privacy">politique de confidentialité</a> pour plus de
            détails.
          </p>
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-item__q">
          <span>Comment supprimer mes données ?</span>
          <i data-lucide="chevron-down" class="faq-item__chevron"></i>
        </summary>
        <div class="faq-item__a">
          <p>
            Vous pouvez demander la suppression de vos données en nous contactant
            via la <a href="/contact">page de contact</a>. La suppression sera
            effectuée dans un délai de 30 jours conformément au RGPD.
          </p>
        </div>
      </details>

    </div>
  </div>
</section>

<!-- CTA -->
<section class="page-cta">
  <div class="container page-cta__inner">
    <h2 data-animate="fadeInUp">Vous n'avez pas trouvé votre réponse ?</h2>
    <p data-animate="fadeInUp">
      Contactez-nous directement ou rejoignez notre serveur Discord pour obtenir
      de l'aide en temps réel.
    </p>
    <div class="page-cta__actions" data-animate="fadeInUp">
      <a href="/contact" class="btn btn-primary btn-xl">
        <i data-lucide="mail"></i>
        <span>Nous contacter</span>
      </a>
      <a href="https://discord.gg/" class="btn btn-outline btn-xl" target="_blank" rel="noopener">
        <i data-lucide="message-circle"></i>
        <span>Serveur Discord</span>
      </a>
    </div>
  </div>
</section>
