<%# Auth Error Page - uses layouts/public.ejs %>

<section class="err-hero">
  <div class="container">
    <div class="err-card">
      <div class="err-card__icon err-card__icon--auth">
        <i data-lucide="shield-x" style="width:48px;height:48px"></i>
      </div>
      <h1 class="err-card__title">Erreur de connexion</h1>
      <p class="err-card__desc">
        <%= typeof reason !== 'undefined' && reason ? reason : "Une erreur est survenue lors de l'authentification." %>
      </p>

      <div class="err-card__actions">
        <a href="/login" class="btn btn--primary btn--lg">
          <i data-lucide="log-in"></i> Réessayer
        </a>
        <a href="/" class="btn btn--outline btn--lg">
          <i data-lucide="home"></i> Accueil
        </a>
      </div>

      <div class="err-card__help">
        <p>Si le problème persiste :</p>
        <ul>
          <li>Vérifiez que les popups sont autorisées pour ce site</li>
          <li>Effacez les cookies et réessayez</li>
          <li>Contactez-nous sur <a href="/contact">la page de contact</a></li>
        </ul>
      </div>
    </div>
  </div>
</section>
