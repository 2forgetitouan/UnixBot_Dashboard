# Discord bot principal
TOKEN=your_bot_token_here
CLIENT_ID=your_discord_application_client_id
CLIENT_SECRET=your_discord_application_client_secret

# Dashboard / API
PORT=3000
UNIFIED_PORT=3000
BASE_URL=http://localhost:3000
REDIRECT_URI=http://localhost:3000/api/auth/callback

# Session et chiffrement
SESSION_SECRET=replace_with_a_long_random_secret
ENCRYPTION_KEY=replace_with_64_hex_chars

# Bridge vers le bot en mode remote
BOT_INTERNAL_HOST=127.0.0.1
BOT_INTERNAL_PORT=3002
INTERNAL_API_SECRET=optional_internal_secret

# Optionnel
NODE_ENV=development
DEBUG=false
ADMIN_PASSWORD=change_me
CONTACT_USER_ID=
USER_OWNER=
TENOR_API_KEY=
